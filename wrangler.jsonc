{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "awwal-brand-solution",
  "compatibility_date": "2026-10-20",
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/",
      "/*.html",
      "/*/",
      "/video-editing-course",
      "/videography-course",
      "/photography-course",
      "/photo-editing-course",
      "/motion-graphics-course",
      "/graphic-design-course",
      "/digital-marketing-course",
      "/web-design-course"
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/video-editing-course.html",
        "**/videography-course.html",
        "**/photography-course.html",
        "**/photo-editing-course.html",
        "**/motion-graphics-course.html",
        "**/graphic-design-course.html",
        "**/digital-marketing-course.html",
        "**/web-design-course.html"
      ],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": [
        "**/course-guides/*.pdf"
      ],
      "fallthrough": true
    }
  ],
  "previews": {},
  "main": "enquiry-worker.mjs",
  "d1_databases": [
    {
      "binding": "ENQUIRIES",
      "database_name": "awwal-enquiries",
      "database_id": "82a851f3-8461-4426-b88f-c85b92fbbd87"
    }
  ]
}
